#!/usr/bin/env python

import sys
import pathlib
import argparse

from cbtools import configure_logging
from cbtools.convert import convert


_program_name = 'cbconvert'
_logger = configure_logging()


def parse_args(argv=sys.argv):
    parser = argparse.ArgumentParser(prog=_program_name)
    parser.add_argument('files', nargs='+', type=pathlib.Path)
    parser.add_argument('--path', dest='root', type=pathlib.Path)
    parser.add_argument('-d', '--delete-source', action='store_true', help='Delete source files after processing')
    parser.add_argument('--join-spreads', dest='join_spreads', action='store_true',
                        help='Detect and join facing-page spreads (before rotation)')
    parser.add_argument('--spread-probability', dest='spread_probability', type=float, default=None,
                        help='Spread detection threshold (default: 0.5)')
    parser.add_argument('--model-name', dest='model_name', type=str, default=None,
                        help='Model name or .pth path (default: manga-digital)')
    args = parser.parse_args(argv[1:])
    return vars(args)


def main():
    args = parse_args()

    try:
        sts = convert(**args)
    except KeyboardInterrupt:
        return 1

    return sts


if __name__ == '__main__':
    sys.exit(main())
